<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Speisekarte</h1>
  <div>
    <%= link_to "Warenkorb ansehen", cart_path, class: "btn btn-outline-primary" %>
    <% if logged_in? && policy(MenuItem).create? %>
      <%= link_to "Neuen Artikel anlegen", new_menu_item_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<% @menu_items.group_by(&:department).each do |department, items| %>
  <h2 class="h4 mt-4 mb-3"><%= department == "kitchen" ? "Küche" : "Bar" %></h2>

  <div class="row row-cols-1 row-cols-md-3 g-3">
    <% items.each do |item| %>
      <div class="col">
        <div class="card h-100 <%= "opacity-50" unless item.available? %>">
          <div class="card-body">
            <h5 class="card-title">
              <%= item.name %>
              <% unless item.available? %>
                <span class="badge bg-secondary">ausverkauft</span>
              <% end %>
            </h5>
            <p class="card-text"><%= item.description %></p>
            <p class="card-text"><strong>CHF <%= item.price %></strong></p>
          </div>
          <div class="card-footer bg-white border-0 d-flex justify-content-between">
            <% if item.available? %>
              <%= button_to "In den Warenkorb", add_to_cart_path(item.id), method: :post, class: "btn btn-sm btn-success" %>
            <% end %>
            <% if logged_in? && policy(item).update? %>
              <%= link_to "Bearbeiten", edit_menu_item_path(item), class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>