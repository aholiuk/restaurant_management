<h1>Mitarbeiter-Login</h1>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<%= form_with url: session_path, method: :post do |f| %>
  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "Passwort" %><br>
    <%= f.password_field :password %>
  </div>

  <%= f.submit "Anmelden" %>
<% end %>