<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Mein Profil</h1>

        <dl class="row mb-4">
          <dt class="col-sm-4">Name</dt>
          <dd class="col-sm-8"><%= @employee.name %></dd>

          <dt class="col-sm-4">E-Mail</dt>
          <dd class="col-sm-8"><%= @employee.email %></dd>

          <dt class="col-sm-4">Rolle</dt>
          <dd class="col-sm-8"><span class="badge bg-secondary"><%= @employee.role %></span></dd>
        </dl>

        <%= link_to "Profil bearbeiten", edit_profile_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>