    <div class="container">
      <button class="navbar-toggler order-1" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <%= link_to "Rattle", dashboard_path, class: "navbar-brand ms-2 order-2" %>

      <ul class="navbar-nav ms-auto order-3 order-lg-4">
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" title="<%= current_employee.name %>">
