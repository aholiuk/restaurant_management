<h1 class="mb-4">Aktivitäten-Feed</h1>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Zeitpunkt</th>
        <th>Bestellung</th>
        <th>Status</th>
        <th>Von</th>
      </tr>
    </thead>
    <tbody>
      <% @logs.each do |log| %>
        <tr>
          <td class="text-muted"><%= log.changed_at.in_time_zone.strftime("%d.%m.%Y %H:%M:%S") %></td>
          <td>#<%= log.order.id %> (<%= log.order.customer_name %>)</td>
          <td><span class="badge bg-secondary"><%= log.status %></span></td>
          <td><%= log.employee&.name || "Kunde" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>