<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Mitarbeiterübersicht</h1>
  <%= link_to "Neuen Mitarbeiter anlegen", new_registration_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>E-Mail</th>
        <th>Rolle</th>
        <th>Aktiv</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @employees.each do |employee| %>
        <tr>
          <td><%= employee.name %></td>
          <td><%= employee.email %></td>
          <td><span class="badge bg-secondary"><%= employee.role %></span></td>
          <td>
            <% if employee.active? %>
              <span class="badge bg-success">Ja</span>
            <% else %>
              <span class="badge bg-danger">Nein</span>
            <% end %>
          </td>
          <td class="text-end">
            <%= link_to "Bearbeiten", edit_employee_path(employee), class: "btn btn-sm btn-outline-secondary" %>
            <% if policy(employee).destroy? %>
              <%= button_to "Löschen", employee_path(employee), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Wirklich löschen?" }, class: "d-inline" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>